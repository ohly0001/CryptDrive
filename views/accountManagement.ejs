<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>Account Management</title>
        <script src="/js/accountManagement.js" defer></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/accountManagement.css">
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
    </head>
    <body>
        <%- include('components/master') %>
        <%- include('components/nav') %>
        
        <h1>Account Management</h1>
        <fieldset>
            <legend>Account Details</legend>
            <div id="accountDetails">
                <label for="username"><i class="fa-solid fa-hashtag"></i> Username</label><br>
                <input id="username" type="text"><br><br>
                <label for="email"><i class="fa-solid fa-at"></i> Email</label><br>
                <input id="email" type="email" readonly><br><br>
                <label for="accountType"><i class="fa-solid fa-user-tag"></i> Account Type</label><br>
                <input id="accountType" type="accountType" readonly>
            </div>
        </fieldset>
        <fieldset>
            <legend>Account Management</legend>
            <div id="accountManagement">
                <button id="editAccount"><i class="fas fa-user-edit"></i> Edit Account</button><br><br>
                <button id="cancelEditAccount" style="display: none;"><i class="fa-solid fa-xmark"></i> Cancel Editting</button>
                <a href="./passwordResetCode.html">Reset Password</a><br><br>
                <button id="deleteAccount"><i class="fa-solid fa-trash"></i> Delete Account</button>
            </div>
        </fieldset>
        <fieldset>
            <legend>Session & Navigation</legend>
            <div id="navigation">
                <button id="logout"><i class="fa-solid fa-door-closed"></i> Logout</button><br><br>
            </div>
        </fieldset>
        <p id="createdAt"><i class="fa-solid fa-clock"></i> Created On:</p>
        <p id="updatedAt"><i class="fa-regular fa-clock"></i> Last Updated On:</p>
    </body>
</html>