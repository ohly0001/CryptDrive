<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>CyptDrive New Password</title>
        <script src="/js/addPassword.js" defer></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/addPassword.css">
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
    </head>
    <body>
        <h1>CyptDrive New Password</h1>
        <form id="newPasswordForm">
        <fieldset>
            <legend>Add Password</legend>

            <label for="newTitle"><i class="fa-solid fa-user-tag"></i> Title</label>
            <input id="newTitle" type="text" placeholder="Example" size="128" required><br>

            <label for="newUrl"><i class="fa-solid fa-link"></i> URL</label>
            <input id="newUrl" type="url" placeholder="https://example.com" size="128" required><br>

            <label for="newUser"><i class="fa-solid fa-id-card"></i> Username</label>
            <input id="newUser" type="text" placeholder="abc@email.com" size="128" required><br>

            <label for="newPassword"><i class="fa-solid fa-key"></i> Password</label>
            <input id="newPassword" type="password" size="128">
            <button id="passwordPeek" type="button" title="Reveal Password"><i class="fa-solid fa-eye-slash"></i></button><br>

            <label for="newFavourite">
                <i class="fa-solid fa-star"></i> Favourite
                <input id="newFavourite" type="checkbox">
            </label><br>

            <label for="newTag"><i class='fas fa-tags'></i> Add Search Tag</label>
            <input id="newTag" type="text" title="Press enter to add" placeholder="work"><br>
            <div class="tagContainer" id="newTags"></div><br>

            <label for="newNote"><i class='fas fa-sticky-note'></i> Note</label><br>
            <textarea id="newNote" rows="3" placeholder="Optional note..."></textarea><br>

            <input type="submit" value="Add Password">
            <button type="button" onclick="document.location.href='/home/passwordVault';">↩ Back</button>
        </fieldset>
    </form>
    </body>
</html>