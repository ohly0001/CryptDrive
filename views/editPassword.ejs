<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>Edit Password</title>
        <script>
            window.__PASSWORD__ = <%- JSON.stringify(password) %>;
        </script>
        <script src="/js/editPassword.js" defer></script>
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/editPassword.css">
        <style>
            body { font-family: -apple-system, sans-serif; line-height: 1.6; max-width: 900px; margin: 40px auto; padding: 0 20px; color: #333; }
            pre { border-radius: 8px; padding: 1em; overflow: auto; }
        </style>
    </head>
    <body>
        <%- include('components/master') %>

        <h1>Edit Password</h1>
        <form id="editPasswordForm">
        <fieldset>
            <legend>Edit Password</legend>

            <label for="savedTitle">Title</label><br>
            <input id="savedTitle" type="text" placeholder="<%= password.title %>" size="128" value="<%= password.title %>" required><br><br>

            <label for="savedUrl"><i class="fa-solid fa-link"></i> URL</label><br>
            <input id="savedUrl" type="url" placeholder="https://example.com" size="128" value="<%= password.url %>" required><br><br>

            <label for="savedUser"><i class="fa-solid fa-id-card"></i> Username</label><br>
            <input id="savedUser" type="text" placeholder="<%= password.username %>" size="128" value="<%= password.username %>" required><br><br>

            <label for="savedPassword"><i class="fa-solid fa-key"></i> Password</label><br>
            <input id="savedPassword" type="password" autocomplete="off" size="128" value="<%= password.password %>">
            <button id="passwordPeek" type="button" title="Reveal Password"><i class="fa-solid fa-eye"></i></button><br><br>

            <label for="savedFavourite"><i class="fa-solid fa-star"></i> Flag as Favourite?</label><br>
            <input id="savedFavourite" type="checkbox" <%= password.isFavourite ? "checked" : "" %>><br><br>

            <label for="savedTag"><i class="fa-solid fa-tags"></i> Add Tag</label><br>
            <input id="savedTag" type="text" title="Press enter to add"><br>
            <div class="tagContainer" id="savedTags"></div><br><br>

            <label for="savedNote"><i class='fas fa-sticky-note'></i> Note</label><br>
            <textarea id="savedNote" rows="6" cols="64" placeholder="<%= password.note %>" ><%= password.note %></textarea><br>

            <input type="submit" value="Save">
            <button type="button" id="delete"><i class="fa-solid fa-trash"></i> Delete</button>
            <button type="button" id="revert"><i class="fa-solid fa-clock-rotate-left"></i> Discard Changes</button>
            <button type="button" id="back">↩ Back</button>
        </fieldset>
        <p id="creationTime"><i class="fa-solid fa-clock"></i> Created On: <%= new Date(password.createdAt || Date.now()).toLocaleString() %></p>
        <p id="updatedTime">
        <i class="fa-regular fa-clock"></i> Last Updated On: 
        <%= (password.updatedAt && password.createdAt && password.updatedAt !== password.createdAt) 
            ? new Date(password.updatedAt).toLocaleString() 
            : "Never" %>
        </p>
    </form>
    </body>
</html>