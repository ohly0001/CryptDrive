<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>CyptDrive Edit Password</title>
        <script src="/js/editPassword.js" defer></script>
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/editPassword.css">
    </head>
    <body>
        <h1>CyptDrive Edit Password</h1>
        <form id="addPasswordForm">
        <fieldset>
            <legend>Edit Password</legend>

            <label for="savedTitle">Title</label><br>
            <input id="savedTitle" type="text" placeholder="Example" size="128" required><br><br>

            <label for="savedUrl"><i class="fa-solid fa-link"></i> URL</label>
            <input id="savedUrl" type="url" placeholder="https://example.com" size="128" required><br>

            <label for="savedUser">Username</label>
            <input id="savedUser" type="text" placeholder="abc@email.com" size="128" required><br>

            <label for="savedPassword"><i class="fa-solid fa-key"></i> Password</label>
            <input id="savedPassword" type="password" size="128">
            <button id="passwordPeek" type="button" title="Reveal Password"><i class="fa-solid fa-eye"></i></button><br>

            <label for="savedTag"><i class="fa-solid fa-tags"></i> Add Tag</label>
            <input id="savedTag" type="text" title="Whitespace Delimited">
            <div class="tagContainer" id="savedTags"></div><br>

            <label for="savedNote"><i class='fas fa-sticky-note'></i> Note</label><br>
            <textarea id="savedNote" rows="3" placeholder="Optional note..."></textarea><br>

            <input type="submit" value="Save">
            <button>Delete</button>
            <button type="button" onclick="document.location.reload();">Revert</button>
            <button type="button" onclick="document.location.href='/home/passwordVault';">↩ Back</button>
        </fieldset>
        <p id="creationTime"><i class="fa-solid fa-clock"></i> Created On:</p>
        <p id="updatedTime"><i class="fa-regular fa-clock"></i> Last Updated On:</p>
    </form>
    </body>
</html>