<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="author" content="Robert Ohly">
    <title>File Repository</title>
    <script>
        window.__CURRENT_USER__ = <%- JSON.stringify(userId) %>;
    </script>
    <script src="/js/fileRepository.js" defer></script>
    <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/fileRepository.css">
</head>
<body>
    <%- include('components/master') %>
    <%- include('components/nav') %>

    <h1>File Repository</h1>

    <!-- Drag & drop / file select -->
    <main class="repository-container">
    <section class="action-card">
        <div id="dropZone" class="upload-area">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <p><b>Choose a file</b> or drag files here</p>
        </div>

        <div class="primary-actions">
            <button id="createDirBtn" class="btn-primary">
                <i class="fa-solid fa-plus"></i> New Folder
            </button>
        </div>

        <form id="searchForm" class="filter-group">
            <div class="search-bar-wrapper">
                <input id="currentPath" type="text" class="path-input" placeholder="/" required title="Current Directory">
                <input id="searchField" type="text" class="search-input" placeholder="Search files or folders...">
                <div class="search-tools">
                    <button id="matchCase" type="button" title="Match Case"><i class="fa fa-font"></i></button>
                    <button id="matchEntire" type="button" title="Match Whole Word"><i class="fa-solid fa-underline"></i></button>
                    <button id="useRegex" type="button" title="Use Regex"><i class="fa fa-code"></i></button>
                    <button type="submit" class="btn-refresh"><i class="fa-solid fa-rotate"></i></button>
                </div>
            </div>

            <div class="filter-buttons">
                <button type="button" id="favorite" class="btn-toggle"><i class="fa-regular fa-star"></i> Favourites</button>
                <button id="sortMode" class="btn-toggle">Sort By: <i class="fa-solid fa-arrow-down-a-z"></i></button>
                <button id="blacklistTags" class="btn-toggle"><i class="fa-solid fa-filter"></i> Blacklist</button>
                <button id="clearTags" class="btn-toggle"><i class="fa-solid fa-filter-circle-xmark"></i> Clear</button>
            </div>
            
            <div class="tag-input-wrapper">
                <i class="fa-solid fa-tag"></i>
                <input type="text" id="tagFilter" placeholder="Add search tag...">
                <div class="tagContainer" id="newTags"></div>
            </div>
        </form>
    </section>

    <nav class="breadcrumb-nav">
        <button id="navToParent" class="btn-back" title="Go Back">
            <i class="fa-solid fa-chevron-left"></i> Back
        </button>
    </nav>

    <div id="fileList" class="card-list"></div>
</main>
</body>
</html>
