<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>Authentication</title>
        <script src="/js/login.js" defer></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/login.css">
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
    </head>
    <body>
        <h1>Login</h1>
        <form id="form">
            <fieldset>
                <legend>Login</legend>
                <label for="identification"><i class="fa-solid fa-id-card"></i> Username or Email</label>
                <input id="identification" type="text" placeholder="jsmith@email.com" autocomplete="on" required>

                <label for="password"><i class="fa-solid fa-key"></i> Password</label>
                <div class="password-row">
                    <input id="password" autocomplete="off" type="password" required>
                    <button type="button" id="passwordPeek" title="Reveal Password">
                        <i class="fa-solid fa-eye-slash"></i>
                    </button>
                </div>

                <input id="loginSubmit" type="submit" value="Login">
                
                <div style="text-align: center; margin-top: 15px;">
                    <a href="./passwordResetCode.html" style="text-decoration: none; color: #1877f2; font-size: 0.9rem;">Forgot Password?</a>
                </div>
            </fieldset>

            <fieldset>
                <legend>Other</legend>
                <button id="registerBtn" type="button" onclick="document.location.href='/auth/register'">Register</button>
            </fieldset>
        </form>
    </body>
</html>