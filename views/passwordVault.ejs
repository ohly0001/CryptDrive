<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <meta name="author" content="Robert Ohly">
    <title>CryptDrive Password Vault</title>
    <script src="/js/passwordVault.js" defer></script>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/passwordVault.css">
    <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
</head>
<body>
    <%- include('components/nav') %>

    <h1>CryptDrive Password Vault</h1>

    <!-- ADD PASSWORD -->
    <button id="addPasswordButton">Add Password</button>

    <!-- SEARCH PASSWORDS -->
    <form id="searchForm">
        <fieldset>
            <legend>Search for Passwords</legend>
            <input id="searchField" type="text" placeholder="Enter Title or Tag">

            <button id="matchCase" type="button" title="Match Case"><i class="fa fa-font"></i></button>
            <button id="matchEntire" type="button" title="Match Whole Word"><i class="fa-solid fa-underline"></i></button>
            <button id="useRegex" type="button" title="Use Regex"><i class="fa fa-code"></i></button>

            <button type="submit">Search</button>

            <!-- FAVORITES FILTER -->
            <button type="button" id="favorite"> <i class="fa fa-star"></i> Favourites</button>

            <!-- TITLE SORT -->
            <label for="titleSort">Sort by Title:</label>
            <select id="titleSort">
                <option value="asc">A → Z</option>
                <option value="desc">Z → A</option>
            </select>

            <!-- TAG FILTER -->
            <button id="blacklistTags"><i class="fa-solid fa-filter-circle-xmark"></i> Blacklist Tags</button>
            <label for="tagFilter">Tag Filter</label>
            <input type="text" id="tagFilter" placeholder="Tag name">
        </fieldset>
    </form>

    <!-- BATCH ACTIONS -->
    <div id="batchActions">
        <button type="button" id="selectAll">Select All</button>
        <button type="button" id="deselectAll">Deselect All</button>
        <button type="button" id="deleteSelected"><i class="fa-solid fa-trash"></i> Delete Selected</button>
        <button type="button" id="favouriteSelected"><i class="fa fa-star"></i> Toggle Favourite</button>
    </div>

    <!-- PASSWORD LIST -->
    <div id="passwordContainer"></div>
    <div id="loadingIndicator" style="text-align:center; padding:20px; opacity:.6;">
        Scrolling loads more...
    </div>
</body>
</html>