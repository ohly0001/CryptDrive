<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta charset="UTF-8">
        <meta name="author" content="Robert Ohly">
        <title>Registration</title>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/zxcvbn/4.4.2/zxcvbn.js"></script>
        <script src="https://kit.fontawesome.com/0f23db6f2c.js" crossorigin="anonymous"></script>
        <script src="/js/register.js" defer></script>
        <link rel="stylesheet" href="/css/site.css">
        <link rel="stylesheet" href="/css/register.css">
    </head>
    <body>
        <h1>Registration</h1>
        <form id="form">
            <fieldset>
                <legend>Register</legend>
                <label for="username"><i class="fa-solid fa-hashtag"></i> Username</label><br>
                <input id="username" type="text" placeholder="John Smith" title="case-sensitive" required><br><br>
                <label for="email"><i class="fa-solid fa-at"></i> Email</label><br>
                <input id="email" type="email" placeholder="jsmith@email.com" title="case-insensitive" required><br><br>
                <label for="password1"><i class="fa-solid fa-key"></i> Password</label>
                <div class="password-row">
                    <input id="password1" autocomplete="off" type="password" required>
                    <button id="passwordPeek" type="button" title="Reveal Password">
                        <i class="fa-solid fa-eye-slash"></i>
                    </button>
                </div>

                <meter id="passwordStrength" min="0" max="4" low="2" high="3" optimum="4"></meter>
                <label for="passwordStrength" id="passwordStrengthLabel">Password Strength</label>

                <label for="password2"><i class="fa-solid fa-lock"></i> Confirm Password</label>
                <input id="password2" autocomplete="off" type="password" required>
                <input type="submit" value="Register">
            </fieldset>
            <fieldset>
                <legend>Other</legend>
                <button id="loginBtn" type="button" onclick="document.location.href='/auth/login'">Login</button>
            </fieldset>
        </form>
    </body>
</html>